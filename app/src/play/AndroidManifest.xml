<?xml version="1.0" encoding="utf-8"?>
<!-- Merged only into Google Play builds (-Phb.play=true): the Wear OS watch link. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name="org.highbridge.app.wear.WearListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/highbridge" />
            </intent-filter>
        </service>
    </application>
</manifest>
